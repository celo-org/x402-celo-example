# Network: leave unset for Celo Sepolia, or set to mainnet for Celo mainnet.
# X402_NETWORK=mainnet

# Seller. Create a key at https://x402.celo.org (connect wallet, sign, no gas).
# Server-side secret: never expose it to browsers or buyers.
X402_API_KEY=
# The address that receives the USDC.
SELLER_PAY_TO=

# Buyer. A throwaway wallet funded with a little USDC; no CELO needed.
BUYER_PRIVATE_KEY=

# A2A example (npm run a2a:merchant / a2a:buyer / a2a:demo). Uses the values above.
# Token: USDC (default). On mainnet also USDT (USD₮) or USAT (USA₮).
# X402_TOKEN=USDC
# The buyer refuses to sign anything above this per payment.
# BUYER_MAX_PER_PAYMENT=$0.05
# A2A_PORT=4000
# MERCHANT_URL=http://localhost:4000
